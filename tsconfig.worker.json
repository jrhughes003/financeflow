{
  // A separate project because lib.dom and lib.webworker cannot coexist: they
  // redeclare self, fetch and addEventListener, which produces dozens of
  // duplicate-identifier errors. The Monte Carlo worker genuinely needs the
  // WebWorker lib — it uses self.postMessage and self.onmessage — so the
  // alternative would be hand-declaring `self` and giving up on typing the
  // message protocol, which is the one thing there worth typing.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  // Exactly the workers' import graphs, listed rather than globbed.
  //
  // Every file in a project's graph has to be inside its include, but globbing
  // src/utils/lifeplan drags in snapshot.ts, which reaches calculations and
  // insights and from there modules that touch `document`. The whole point of
  // compiling this separately is that the WebWorker lib has no DOM, so a file
  // that needs one does not belong here — and naming the ones that don't makes
  // that boundary visible instead of accidental.
  //
  // The payoff worker brings the second block below. Every one of those was
  // checked for a DOM reference before being added; the only `window` in them
  // is a local parameter in insights.ts and some prose in comments. If a file
  // here ever reaches for `document`, this project stops compiling, which is
  // the point of keeping the list by hand.
  "include": [
    "src/workers",
    "src/types",
    "src/utils/lifeplan/montecarlo.ts",
    "src/utils/lifeplan/engine.ts",
    "src/utils/lifeplan/returns.ts",
    "src/utils/lifeplan/taxCanada.ts",
    "src/utils/lifeplan/housing.ts",

    "src/utils/optimizePayoff.ts",
    "src/utils/planning.ts",
    "src/utils/calculations.ts",
    "src/utils/constants.ts",
    "src/utils/reimbursements.ts",
    "src/utils/accounts.ts",
    "src/utils/insights.ts",
    "src/utils/recurring.ts",
    "src/utils/categorization.ts"
  ]
}
