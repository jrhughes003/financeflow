{
  "name": "financeflow",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "ai:mock": "node electron/ai/mockServer.cjs",
    "electron:dev:mock": "concurrently -k \"npm run ai:mock\" \"vite\" \"wait-on tcp:5173 tcp:8787 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 FINANCEFLOW_AI_BASE_URL=http://127.0.0.1:8787 electron .\"",
    "dist": "vite build && electron-builder && node scripts/verifyPackage.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stats": "node scripts/stats.cjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.10.2",
    "globals": "^15.15.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.3.4",
    "vitest": "^2.0.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.financeflow.app",
    "productName": "FinanceFlow",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.*",
      "!electron/ai/mockServer.cjs"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
